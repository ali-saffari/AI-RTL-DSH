{
  "name": "ai-rtl-dsh",
  "version": "1.1.0",
  "description": "Smart RTL: AI RTL for DeepSeek Harness.",
  "keywords": ["deepseek-harness", "dsh-plugin", "rtl", "persian", "farsi", "arabic", "hebrew"],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ali-saffari/AI-RTL-DSH.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "icon": "./icon.png",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
