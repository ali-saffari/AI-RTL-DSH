{
  "name": "ai-rtl-dsh",
  "version": "1.1.3",
  "description": "Smart RTL: AI RTL for DeepSeek Harness.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "rtl",
    "persian",
    "farsi",
    "arabic",
    "hebrew"
  ],
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/ali-saffari/AI-RTL-DSH.git"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "icon": "./dist/icon.png",
  "scripts": {
    "build": "webpack --config private/webpack.config.js",
    "watch": "webpack --config private/webpack.config.js --watch"
  },
  "dsh": {
    "bundle": {
      "patch": "./dist/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "devDependencies": {
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  }
}
